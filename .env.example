# Copy this file to .env and fill in real values.
#
# .env is gitignored; this repository is PUBLIC, so a token pasted into a
# tracked file is a leaked token. Nothing here is ever read from config.yaml.
#
# Get a token from @BotFather, and read your own chat id by messaging the bot
# once and then running:  kya --whoami

KYA_TELEGRAM_BOT_TOKEN=
KYA_TELEGRAM_CHAT_ID=

# Milestone C (webhook worker). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# One secret, two doors: Telegram sends it back on every webhook POST, and it
# doubles as the Bearer token for the worker's GET /decisions endpoint.
# The same value must be set as the worker secret WEBHOOK_SECRET (see
# worker/README.md).
KYA_TELEGRAM_WEBHOOK_SECRET=

# Optional: where the deployed worker serves its decisions. When unset the
# digest simply never filters. Example:
#   KYA_DECISIONS_URL=https://kya-webhook.<your-subdomain>.workers.dev/decisions
KYA_DECISIONS_URL=
